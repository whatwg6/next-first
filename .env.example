# Node.js 22+. Copy to .env.local and replace the placeholders.
# Use 5433 on the host to avoid conflicts with other local PostgreSQL services.
DATABASE_URL=postgresql://account:account_local@localhost:5433/account
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Local Mailpit: SMTP port 1025, inbox http://localhost:8025
# Production: configure your SMTP host, sender and credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="账号中心 <noreply@example.com>"
